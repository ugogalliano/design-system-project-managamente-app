{
  "name": "@ugogalliano/pm-design-system-vue",
  "version": "0.2.0",
  "description": "Design System Vue 3 per Project Management",
  "type": "module",
  "packageManager": "pnpm@10.26.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ugogalliano/design-system-project-managamente-app.git"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/pm-design-system.js",
      "require": "./dist/pm-design-system.umd.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "scripts": {
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\" \"tests/**/*.{ts,vue}\"",
    "commitlint": "commitlint --edit",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "ci:publish": "changeset publish",
    "prepare": "husky",
    "prepublishOnly": "pnpm run build"
  },
  "lint-staged": {
    "*.{ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json}": [
      "prettier --write"
    ]
  },
  "peerDependencies": {
    "@vee-validate/zod": "^4.13.0",
    "reka-ui": "^2.0.0",
    "vee-validate": "^4.13.0",
    "vue": "^3.4.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "^19.8.1",
    "@eslint/js": "^9.10.0",
    "@storybook/addon-a11y": "8.6.18",
    "@storybook/addon-essentials": "8.6.18",
    "@storybook/addon-interactions": "8.6.18",
    "@storybook/blocks": "8.6.18",
    "@storybook/test": "8.6.18",
    "@storybook/vue3": "8.6.18",
    "@storybook/vue3-vite": "8.6.18",
    "@types/node": "^22.5.0",
    "@vee-validate/zod": "^4.13.0",
    "@vitejs/plugin-vue": "^5.1.0",
    "@vue/test-utils": "^2.4.0",
    "autoprefixer": "^10.4.20",
    "clsx": "^2.1.0",
    "eslint": "^9.10.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.28.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.0",
    "lint-staged": "^15.5.2",
    "postcss": "^8.4.45",
    "prettier": "^3.3.0",
    "reka-ui": "^2.0.0",
    "storybook": "8.6.18",
    "tailwind-merge": "^2.5.0",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.6.0",
    "vee-validate": "^4.13.0",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^4.2.0",
    "vitest": "^2.1.0",
    "vue": "^3.5.0",
    "vue-tsc": "^2.1.0",
    "zod": "^3.23.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
